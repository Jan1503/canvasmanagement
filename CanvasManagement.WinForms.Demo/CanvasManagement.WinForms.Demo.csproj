<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SkiaSharp.Views.WindowsForms 3.116 still pulls netframework OpenTK; no net10 package exists. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CanvasManagement.Interfaces\CanvasManagement.Interfaces.csproj" />
    <ProjectReference Include="..\CanvasManagement\CanvasManagement.csproj" />
  </ItemGroup>
</Project>